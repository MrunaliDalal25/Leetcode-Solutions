
class Solution {
    public int firstUniqChar(String s) {

        int[] freq = new int[26];

        // Step 1: Count frequency of each character
        for (int i = 0; i < s.length(); i++) {
            freq[s.charAt(i) - 'a']++;
        }

        // Step 2: Find first non-repeating character
        for (int i = 0; i < s.length(); i++) {

            char ch = s.charAt(i);

            if (freq[ch - 'a'] == 1) {
                return i;
            }
        }

        return -1;
    }
}
