
class Solution {

    public int minimumChanges(String s, int k) {

        int n = s.length();

        // cost[i][j] = minimum changes to make s[i...j]
        // a semi-palindrome
        int[][] cost = new int[n][n];

        // Step 1: Precompute substring costs
        for (int i = 0; i < n; i++) {

            for (int j = i + 1; j < n; j++) {

                int len = j - i + 1;
                int minCost = Integer.MAX_VALUE;

                // Find proper divisors
                for (int d = 1; d < len; d++) {

                    if (len % d != 0) {
                        continue;
                    }

                    int changes = 0;

                    // Compare symmetric positions
                    // in each modulo-d group
                    for (int offset = 0; offset < d; offset++) {

                        int left = i + offset;
                        int right = j - (d - 1 - offset);

                        while (left < right) {

                            if (s.charAt(left) != s.charAt(right)) {
                                changes++;
                            }

                            left += d;
                            right -= d;
                        }
                    }

                    minCost = Math.min(minCost, changes);
                }

                cost[i][j] = minCost;
            }
        }

        // Step 2: DP
        // dp[i][parts] = minimum changes to divide
        // first i characters into exactly parts substrings

        int INF = 1_000_000;

        int[][] dp = new int[n + 1][k + 1];

        for (int[] row : dp) {
            java.util.Arrays.fill(row, INF);
        }

        dp[0][0] = 0;

        for (int i = 1; i <= n; i++) {

            for (int parts = 1; parts <= k; parts++) {

                // Last substring starts at j
                for (int j = 0; j < i; j++) {

                    // Every substring must have length >= 2
                    if (i - j < 2) {
                        continue;
                    }

                    if (dp[j][parts - 1] == INF) {
                        continue;
                    }

                    dp[i][parts] = Math.min(
                        dp[i][parts],
                        dp[j][parts - 1] + cost[j][i - 1]
                    );
                }
            }
        }

        return dp[n][k];
    }
}
