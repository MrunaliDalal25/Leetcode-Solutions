
class Solution {
    public boolean isValidSerialization(String preorder) {

        int slots = 1;

        String[] nodes = preorder.split(",");

        for (String node : nodes) {

            // No available position for another node
            if (slots == 0) {
                return false;
            }

            // Consume one available slot
            slots--;

            // Non-null node creates two child slots
            if (!node.equals("#")) {
                slots += 2;
            }
        }

        // Valid only when all slots are filled
        return slots == 0;
    }
}
