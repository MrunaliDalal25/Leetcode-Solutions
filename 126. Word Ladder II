class Solution {
    Map<String, List<String>> parents = new HashMap<>();
    List<List<String>> result = new ArrayList<>();
    List<String> path = new ArrayList<>();

    public List<List<String>> findLadders(
            String beginWord, String endWord, List<String> wordList) {

        Set<String> dict = new HashSet<>(wordList);

        if (!dict.contains(endWord)) {
            return result;
        }

        Set<String> current = new HashSet<>();
        current.add(beginWord);

        boolean found = false;

        while (!current.isEmpty() && !found) {
            dict.removeAll(current);

            Set<String> next = new HashSet<>();

            for (String word : current) {
                char[] chars = word.toCharArray();

                for (int i = 0; i < chars.length; i++) {
                    char original = chars[i];

                    for (char c = 'a'; c <= 'z'; c++) {
                        chars[i] = c;
                        String nextWord = new String(chars);

                        if (!dict.contains(nextWord)) {
                            continue;
                        }

                        next.add(nextWord);

                        parents
                            .computeIfAbsent(nextWord, k -> new ArrayList<>())
                            .add(word);

                        if (nextWord.equals(endWord)) {
                            found = true;
                        }
                    }

                    chars[i] = original;
                }
            }

            current = next;
        }

        if (found) {
            path.add(endWord);
            backtrack(endWord, beginWord);
        }

        return result;
    }

    private void backtrack(String word, String beginWord) {
        if (word.equals(beginWord)) {
            List<String> sequence = new ArrayList<>(path);
            Collections.reverse(sequence);
            result.add(sequence);
            return;
        }

        for (String parent : parents.getOrDefault(word, new ArrayList<>())) {
            path.add(parent);
            backtrack(parent, beginWord);
            path.remove(path.size() - 1);
        }
    }
}
