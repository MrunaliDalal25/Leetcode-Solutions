import java.util.*;

class Solution {

    static class DSU {
        int[] parent, rank;

        DSU(int n) {
            parent = new int[n];
            rank = new int[n];

            for (int i = 0; i < n; i++) {
                parent[i] = i;
            }
        }

        int find(int x) {
            if (parent[x] != x) {
                parent[x] = find(parent[x]);
            }
            return parent[x];
        }

        boolean union(int a, int b) {
            int pa = find(a);
            int pb = find(b);

            if (pa == pb) return false;

            if (rank[pa] < rank[pb]) {
                parent[pa] = pb;
            } else if (rank[pa] > rank[pb]) {
                parent[pb] = pa;
            } else {
                parent[pb] = pa;
                rank[pa]++;
            }

            return true;
        }
    }

    public int maxStability(int n, int[][] edges, int k) {
        int lo = 1;
        int hi = 200000;
        int ans = -1;

        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;

            if (can(mid, n, edges, k)) {
                ans = mid;
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }

        return ans;
    }

    private boolean can(int target, int n, int[][] edges, int k) {
        DSU dsu = new DSU(n);

        int components = n;

        List<int[]> cost0 = new ArrayList<>();
        List<int[]> cost1 = new ArrayList<>();

        for (int[] e : edges) {
            int u = e[0];
            int v = e[1];
            int s = e[2];
            int must = e[3];

            if (must == 1) {
                if (s < target) {
                    return false;
                }

                if (!dsu.union(u, v)) {
                    return false; // cycle among mandatory edges
                }

                components--;
            } else {
                if (s >= target) {
                    cost0.add(e);
                } else if (2 * s >= target) {
                    cost1.add(e);
                }
            }
        }

        int upgradesUsed = 0;

        for (int[] e : cost0) {
            if (dsu.union(e[0], e[1])) {
                components--;
            }
        }

        for (int[] e : cost1) {
            if (dsu.union(e[0], e[1])) {
                components--;
                upgradesUsed++;

                if (upgradesUsed > k) {
                    return false;
                }
            }
        }

        return components == 1;
    }
}
