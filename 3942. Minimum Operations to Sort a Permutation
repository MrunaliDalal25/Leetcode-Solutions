
class Solution {
    public int minOperations(int[] nums) {
        int n = nums.length;

        int zero = 0;

        for (int i = 0; i < n; i++) {
            if (nums[i] == 0) {
                zero = i;
                break;
            }
        }

        // Check forward cyclic order
        boolean forward = true;

        for (int i = 0; i < n; i++) {
            if (nums[(zero + i) % n] != i) {
                forward = false;
                break;
            }
        }

        // Check reverse cyclic order
        boolean backward = true;

        for (int i = 0; i < n; i++) {
            if (nums[(zero - i + n) % n] != i) {
                backward = false;
                break;
            }
        }

        if (!forward && !backward) {
            return -1;
        }

        // Already sorted or forward cyclic
        if (forward) {
            return Math.min(zero, n - zero + 2);
        }

        // Reverse cyclic order
        int rotations = (zero + 1) % n;

        return 1 + Math.min(rotations, n - rotations);
    }
}
