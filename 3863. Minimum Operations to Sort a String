
class Solution {
    public int minOperations(String s) {

        int n = s.length();

        // Case 1: Already sorted
        boolean sorted = true;

        for (int i = 1; i < n; i++) {
            if (s.charAt(i) < s.charAt(i - 1)) {
                sorted = false;
                break;
            }
        }

        if (sorted) {
            return 0;
        }

        // Case 2: Length 2 cannot be sorted
        // because the entire string cannot be selected.
        if (n == 2) {
            return -1;
        }

        char min = 'z';
        char max = 'a';

        int minCount = 0;
        int maxCount = 0;

        for (int i = 0; i < n; i++) {
            char ch = s.charAt(i);

            if (ch < min) {
                min = ch;
                minCount = 1;
            } else if (ch == min) {
                minCount++;
            }

            if (ch > max) {
                max = ch;
                maxCount = 1;
            } else if (ch == max) {
                maxCount++;
            }
        }

        // Case 3: One operation is sufficient
        if (s.charAt(0) == min || s.charAt(n - 1) == max) {
            return 1;
        }

        // Case 4: Both extreme characters are at the wrong ends
        if (s.charAt(0) == max && s.charAt(n - 1) == min) {

            if (minCount == 1 && maxCount == 1) {
                return 3;
            }

            return 2;
        }

        // Case 5: All other cases
        return 2;
    }
}
