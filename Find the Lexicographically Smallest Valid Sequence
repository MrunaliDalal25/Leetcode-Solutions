import java.util.*;

class Solution {
    public int[] validSequence(String word1, String word2) {

        int n = word1.length();
        int m = word2.length();

        int[] ans = new int[m];

        // last[j] = the last index in word1 from which
        // word2[j...] can be matched exactly.
        int[] last = new int[m];

        Arrays.fill(last, -1);

        int i = n - 1;
        int j = m - 1;

        // Build last[]
        while (i >= 0 && j >= 0) {

            if (word1.charAt(i) == word2.charAt(j)) {
                last[j] = i;
                j--;
            }

            i--;
        }

        // We are allowed to change at most ONE character.
        boolean changed = false;

        j = 0;

        for (i = 0; i < n; i++) {

            if (j == m) {
                break;
            }

            // Case 1: characters already match
            if (word1.charAt(i) == word2.charAt(j)) {

                ans[j] = i;
                j++;

            }
            // Case 2: use our one allowed modification
            else if (!changed &&
                     (j == m - 1 || i < last[j + 1])) {

                ans[j] = i;
                j++;

                changed = true;
            }
        }

        // Couldn't construct the complete sequence
        if (j != m) {
            return new int[0];
        }

        return ans;
    }
}
