SELECT
    customer_id,
    COUNT(*) AS total_orders,

    ROUND(
        SUM(
            CASE
                WHEN (
                    HOUR(order_timestamp) BETWEEN 11 AND 13
                    OR HOUR(order_timestamp) = 14
                    OR HOUR(order_timestamp) BETWEEN 18 AND 20
                    OR HOUR(order_timestamp) = 21
                )
                THEN 1
                ELSE 0
            END
        ) * 100.0 / COUNT(*),
        2
    ) AS peak_hour_percentage,

    ROUND(AVG(order_rating), 2) AS average_rating

FROM restaurant_orders
GROUP BY customer_id

HAVING
    -- At least 3 orders
    COUNT(*) >= 3

    -- At least 60% of orders during peak hours
    AND SUM(
        CASE
            WHEN (
                TIME(order_timestamp) BETWEEN '11:00:00' AND '14:00:00'
                OR TIME(order_timestamp) BETWEEN '18:00:00' AND '21:00:00'
            )
            THEN 1
            ELSE 0
        END
    ) * 1.0 / COUNT(*) >= 0.60

    -- Average rating at least 4.0
    AND AVG(order_rating) >= 4.0

    -- At least 50% of orders must have a rating
    AND COUNT(order_rating) * 1.0 / COUNT(*) >= 0.50

ORDER BY
    average_rating DESC,
    customer_id DESC;
