class Solution {
    private static final int MOD = 1_000_000_007;

    private int limit;
    private Long[][][][] memo;

    public int numberOfStableArrays(int zero, int one, int limit) {
        this.limit = limit;
        memo = new Long[zero + 1][one + 1][3][limit + 1];

        return (int) dfs(zero, one, 2, 0);
    }

    private long dfs(int zero, int one, int last, int len) {
        if (zero == 0 && one == 0) {
            return 1;
        }

        if (memo[zero][one][last][len] != null) {
            return memo[zero][one][last][len];
        }

        long ans = 0;

        // Place 0
        if (zero > 0) {
            if (last == 0) {
                if (len < limit) {
                    ans += dfs(zero - 1, one, 0, len + 1);
                }
            } else {
                ans += dfs(zero - 1, one, 0, 1);
            }
        }

        // Place 1
        if (one > 0) {
            if (last == 1) {
                if (len < limit) {
                    ans += dfs(zero, one - 1, 1, len + 1);
                }
            } else {
                ans += dfs(zero, one - 1, 1, 1);
            }
        }

        ans %= MOD;
        return memo[zero][one][last][len] = ans;
    }
}
