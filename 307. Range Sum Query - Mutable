
class NumArray {

    int[] nums;
    int[] bit;
    int n;

    public NumArray(int[] nums) {

        this.n = nums.length;
        this.nums = nums.clone();

        bit = new int[n + 1];

        // Build Fenwick Tree
        for (int i = 0; i < n; i++) {
            add(i + 1, nums[i]);
        }
    }

    // Update Fenwick Tree
    private void add(int index, int diff) {

        while (index <= n) {

            bit[index] += diff;

            index += index & -index;
        }
    }

    // Calculate prefix sum from index 0 to index-1
    private int prefixSum(int index) {

        int sum = 0;

        while (index > 0) {

            sum += bit[index];

            index -= index & -index;
        }

        return sum;
    }

    // Update element at given index
    public void update(int index, int val) {

        int diff = val - nums[index];

        nums[index] = val;

        add(index + 1, diff);
    }

    // Calculate range sum
    public int sumRange(int left, int right) {

        return prefixSum(right + 1)
             - prefixSum(left);
    }
}
