class Solution {
    public int uniqueXorTriplets(int[] nums) {
        final int MAX = 2048;

        boolean[] pair = new boolean[MAX];

        // XOR of any two elements (same index allowed)
        for (int a : nums) {
            for (int b : nums) {
                pair[a ^ b] = true;
            }
        }

        boolean[] ans = new boolean[MAX];

        // XOR with third element
        for (int x = 0; x < MAX; x++) {
            if (!pair[x]) continue;
            for (int c : nums) {
                ans[x ^ c] = true;
            }
        }

        int count = 0;
        for (boolean b : ans) {
            if (b) count++;
        }

        return count;
    }
}
