
import java.util.*;

class Solution {
    public int maxSelectedElements(int[] nums) {

        Arrays.sort(nums);

        Map<Integer, Integer> dp = new HashMap<>();

        int ans = 0;

        for (int x : nums) {

            int takeOriginal = dp.getOrDefault(x - 1, 0) + 1;

            int takeIncremented = dp.getOrDefault(x, 0) + 1;

            dp.put(x, Math.max(
                dp.getOrDefault(x, 0),
                takeOriginal
            ));

            dp.put(x + 1, Math.max(
                dp.getOrDefault(x + 1, 0),
                takeIncremented
            ));

            ans = Math.max(ans, Math.max(
                dp.get(x),
                dp.get(x + 1)
            ));
        }

        return ans;
    }
}
