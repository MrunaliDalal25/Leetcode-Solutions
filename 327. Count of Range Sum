
class Solution {

    public int countRangeSum(int[] nums, int lower, int upper) {

        int n = nums.length;

        long[] prefix = new long[n + 1];

        // Build prefix sum array
        for (int i = 0; i < n; i++) {
            prefix[i + 1] = prefix[i] + nums[i];
        }

        long[] temp = new long[n + 1];

        return (int) mergeSort(
            prefix, temp, 0, n + 1, lower, upper
        );
    }

    private long mergeSort(
        long[] prefix,
        long[] temp,
        int left,
        int right,
        int lower,
        int upper
    ) {

        // Base case
        if (right - left <= 1) {
            return 0;
        }

        int mid = left + (right - left) / 2;

        long count = 0;

        count += mergeSort(
            prefix, temp, left, mid, lower, upper
        );

        count += mergeSort(
            prefix, temp, mid, right, lower, upper
        );

        // Count valid range sums
        int low = mid;
        int high = mid;

        for (int i = left; i < mid; i++) {

            while (low < right &&
                   prefix[low] - prefix[i] < lower) {
                low++;
            }

            while (high < right &&
                   prefix[high] - prefix[i] <= upper) {
                high++;
            }

            count += high - low;
        }

        // Merge two sorted halves
        int i = left;
        int j = mid;
        int k = left;

        while (i < mid && j < right) {

            if (prefix[i] <= prefix[j]) {
                temp[k++] = prefix[i++];
            } else {
                temp[k++] = prefix[j++];
            }
        }

        while (i < mid) {
            temp[k++] = prefix[i++];
        }

        while (j < right) {
            temp[k++] = prefix[j++];
        }

        // Copy merged elements back
        for (int p = left; p < right; p++) {
            prefix[p] = temp[p];
        }

        return count;
    }
}
