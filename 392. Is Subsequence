
class Solution {
    public boolean isSubsequence(String s, String t) {

        int i = 0;
        int j = 0;

        while (i < s.length() && j < t.length()) {

            // If characters match
            if (s.charAt(i) == t.charAt(j)) {
                i++;
            }

            // Always move through t
            j++;
        }

        // All characters of s were matched
        return i == s.length();
    }
}
