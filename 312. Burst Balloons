
class Solution {
    public int maxCoins(int[] nums) {

        int n = nums.length;

        // Step 1: Add boundary balloons
        int[] arr = new int[n + 2];

        arr[0] = 1;
        arr[n + 1] = 1;

        for (int i = 0; i < n; i++) {
            arr[i + 1] = nums[i];
        }

        // Step 2: Create DP table
        int[][] dp = new int[n + 2][n + 2];

        // Step 3: Consider intervals of increasing length
        for (int len = 2; len <= n + 1; len++) {

            for (int left = 0; left + len <= n + 1; left++) {

                int right = left + len;

                // Step 4: Try every balloon as the last balloon
                for (int k = left + 1; k < right; k++) {

                    int coins = dp[left][k]
                              + dp[k][right]
                              + arr[left] * arr[k] * arr[right];

                    dp[left][right] = Math.max(
                        dp[left][right],
                        coins
                    );
                }
            }
        }

        return dp[0][n + 1];
    }
}
