
class Solution {
    public int[] intersection(int[] nums1, int[] nums2) {

        boolean[] seen = new boolean[1001];

        for (int num : nums1) {
            seen[num] = true;
        }

        boolean[] common = new boolean[1001];

        int count = 0;

        for (int num : nums2) {

            if (seen[num] && !common[num]) {
                common[num] = true;
                count++;
            }
        }

        int[] result = new int[count];

        int index = 0;

        for (int i = 0; i <= 1000; i++) {
            if (common[i]) {
                result[index++] = i;
            }
        }

        return result;
    }
}
