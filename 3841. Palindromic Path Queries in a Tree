
import java.util.*;

class Solution {

    List<Integer>[] graph;
    int[][] up;
    int[] depth, tin, tout, bit;
    char[] chars;

    int timer, LOG;

    void updateBIT(int i, int val, int n) {
        while (i <= n) {
            bit[i] ^= val;
            i += i & -i;
        }
    }

    int queryBIT(int i) {
        int ans = 0;

        while (i > 0) {
            ans ^= bit[i];
            i -= i & -i;
        }

        return ans;
    }

    void dfs(int root) {

        int n = graph.length;

        int[] stack = new int[2 * n];
        int[] parent = new int[n];

        Arrays.fill(parent, root);
        parent[root] = root;

        int top = 0;
        stack[top++] = root;

        while (top > 0) {

            int u = stack[--top];

            if (u >= 0) {

                tin[u] = ++timer;

                up[0][u] = parent[u];

                for (int j = 1; j < LOG; j++) {
                    up[j][u] =
                        up[j - 1][up[j - 1][u]];
                }

                stack[top++] = ~u;

                for (int v : graph[u]) {

                    if (v == parent[u]) continue;

                    parent[v] = u;
                    depth[v] = depth[u] + 1;

                    stack[top++] = v;
                }

            } else {

                int node = ~u;
                tout[node] = timer;
            }
        }
    }

    int lca(int u, int v) {

        if (depth[u] < depth[v]) {
            int temp = u;
            u = v;
            v = temp;
        }

        int diff = depth[u] - depth[v];

        for (int i = 0; i < LOG; i++) {
            if ((diff & (1 << i)) != 0) {
                u = up[i][u];
            }
        }

        if (u == v) return u;

        for (int i = LOG - 1; i >= 0; i--) {
            if (up[i][u] != up[i][v]) {
                u = up[i][u];
                v = up[i][v];
            }
        }

        return up[0][u];
    }

    public List<Boolean> palindromePath(
        int n,
        int[][] edges,
        String s,
        String[] queries
    ) {

        chars = s.toCharArray();

        graph = new ArrayList[n];

        for (int i = 0; i < n; i++) {
            graph[i] = new ArrayList<>();
        }

        for (int[] e : edges) {
            graph[e[0]].add(e[1]);
            graph[e[1]].add(e[0]);
        }

        LOG = 1;
        while ((1 << LOG) <= n) LOG++;

        up = new int[LOG][n];
        depth = new int[n];
        tin = new int[n];
        tout = new int[n];
        bit = new int[n + 1];

        timer = 0;

        dfs(0);

        for (int i = 0; i < n; i++) {
            int mask = 1 << (chars[i] - 'a');

            updateBIT(tin[i], mask, n);
            updateBIT(tout[i] + 1, mask, n);
        }

        List<Boolean> answer = new ArrayList<>();

        for (String q : queries) {

            String[] parts = q.split(" ");

            int u = Integer.parseInt(parts[1]);

            if (parts[0].equals("update")) {

                char c = parts[2].charAt(0);

                int delta =
                    (1 << (chars[u] - 'a')) ^
                    (1 << (c - 'a'));

                updateBIT(tin[u], delta, n);
                updateBIT(tout[u] + 1, delta, n);

                chars[u] = c;

            } else {

                int v = Integer.parseInt(parts[2]);

                int w = lca(u, v);

                int mask =
                    queryBIT(tin[u]) ^
                    queryBIT(tin[v]) ^
                    (1 << (chars[w] - 'a'));

                answer.add(
                    (mask & (mask - 1)) == 0
                );
            }
        }

        return answer;
    }
}
