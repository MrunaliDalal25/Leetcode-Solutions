import java.util.*;

class Solution {
    public int largestSubmatrix(int[][] matrix) {
        int m = matrix.length;
        int n = matrix[0].length;

        int[][] height = new int[m][n];

        // Build heights
        for (int j = 0; j < n; j++) {
            height[0][j] = matrix[0][j];

            for (int i = 1; i < m; i++) {
                if (matrix[i][j] == 1) {
                    height[i][j] = height[i - 1][j] + 1;
                }
            }
        }

        int ans = 0;

        for (int i = 0; i < m; i++) {
            int[] row = height[i].clone();

            // Rearrange columns optimally
            Arrays.sort(row);

            for (int j = 0; j < n; j++) {
                int h = row[j];
                int width = n - j;
                ans = Math.max(ans, h * width);
            }
        }

        return ans;
    }
}
