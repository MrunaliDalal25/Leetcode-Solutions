import java.util.*;

class Solution {

    public long minimumTotalDistance(List<Integer> robot, int[][] factory) {

        Collections.sort(robot);

        Arrays.sort(factory, (a, b) -> Integer.compare(a[0], b[0]));

        int n = robot.size();
        int m = factory.length;

        long INF = Long.MAX_VALUE / 4;

        // dp[i][j] = minimum cost to repair first i robots
        // using first j factories
        long[][] dp = new long[n + 1][m + 1];

        for (int i = 1; i <= n; i++) {
            dp[i][0] = INF;
        }

        for (int j = 1; j <= m; j++) {
            dp[0][j] = 0;
        }

        for (int j = 1; j <= m; j++) {

            int factoryPos = factory[j - 1][0];
            int limit = factory[j - 1][1];

            for (int i = 1; i <= n; i++) {

                // Option 1:
                // Don't assign any robot to this factory
                dp[i][j] = dp[i][j - 1];

                long cost = 0;

                // Option 2:
                // Assign k robots to this factory
                for (int k = 1; k <= Math.min(limit, i); k++) {

                    int robotPos = robot.get(i - k);

                    cost += Math.abs((long) robotPos - factoryPos);

                    if (dp[i - k][j - 1] != INF) {
                        dp[i][j] = Math.min(
                            dp[i][j],
                            dp[i - k][j - 1] + cost
                        );
                    }
                }
            }
        }

        return dp[n][m];
    }
}
