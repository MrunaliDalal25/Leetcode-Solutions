
class Solution {
    public int maxProduct(String[] words) {

        int n = words.length;

        int[] masks = new int[n];

        // Step 1: Generate bitmask for each word
        for (int i = 0; i < n; i++) {

            int mask = 0;

            for (char ch : words[i].toCharArray()) {

                mask |= (1 << (ch - 'a'));
            }

            masks[i] = mask;
        }

        // Step 2: Find maximum product
        int maxProduct = 0;

        for (int i = 0; i < n; i++) {

            for (int j = i + 1; j < n; j++) {

                // Check if words share any character
                if ((masks[i] & masks[j]) == 0) {

                    int product =
                        words[i].length() * words[j].length();

                    maxProduct = Math.max(maxProduct, product);
                }
            }
        }

        return maxProduct;
    }
}
