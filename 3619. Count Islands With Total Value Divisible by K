
class Solution {

    private int dfs(int[][] grid, int row, int col) {

        int m = grid.length;
        int n = grid[0].length;

        // Out of bounds or water
        if (row < 0 || col < 0 || row >= m || col >= n
                || grid[row][col] == 0) {
            return 0;
        }

        // Store current cell value
        int sum = grid[row][col];

        // Mark visited
        grid[row][col] = 0;

        // Explore four directions
        sum += dfs(grid, row - 1, col);
        sum += dfs(grid, row + 1, col);
        sum += dfs(grid, row, col - 1);
        sum += dfs(grid, row, col + 1);

        return sum;
    }

    public int countIslands(int[][] grid, int k) {

        int m = grid.length;
        int n = grid[0].length;

        int count = 0;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {

                if (grid[i][j] > 0) {

                    int islandSum = dfs(grid, i, j);

                    if (islandSum % k == 0) {
                        count++;
                    }
                }
            }
        }

        return count;
    }
}
