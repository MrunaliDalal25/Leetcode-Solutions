
import java.util.*;

class Solution {

    static class Pair {
        String node;
        double weight;

        Pair(String node, double weight) {
            this.node = node;
            this.weight = weight;
        }
    }

    public double[] calcEquation(
        List<List<String>> equations,
        double[] values,
        List<List<String>> queries
    ) {

        // Step 1: Build weighted graph
        Map<String, List<Pair>> graph = new HashMap<>();

        for (int i = 0; i < equations.size(); i++) {

            String a = equations.get(i).get(0);
            String b = equations.get(i).get(1);

            double value = values[i];

            graph.putIfAbsent(a, new ArrayList<>());
            graph.putIfAbsent(b, new ArrayList<>());

            // a / b = value
            graph.get(a).add(new Pair(b, value));

            // b / a = 1 / value
            graph.get(b).add(new Pair(a, 1.0 / value));
        }

        // Step 2: Process queries
        double[] answer = new double[queries.size()];

        for (int i = 0; i < queries.size(); i++) {

            String start = queries.get(i).get(0);
            String end = queries.get(i).get(1);

            // Undefined variables
            if (!graph.containsKey(start) ||
                !graph.containsKey(end)) {

                answer[i] = -1.0;
                continue;
            }

            // Avoid visiting the same node repeatedly
            Set<String> visited = new HashSet<>();

            answer[i] = dfs(start, end, graph, visited, 1.0);
        }

        return answer;
    }

    private double dfs(
        String current,
        String target,
        Map<String, List<Pair>> graph,
        Set<String> visited,
        double product
    ) {

        // Destination found
        if (current.equals(target)) {
            return product;
        }

        visited.add(current);

        // Explore neighboring variables
        for (Pair neighbor : graph.get(current)) {

            if (!visited.contains(neighbor.node)) {

                double result = dfs(
                    neighbor.node,
                    target,
                    graph,
                    visited,
                    product * neighbor.weight
                );

                if (result != -1.0) {
                    return result;
                }
            }
        }

        // No valid path found
        return -1.0;
    }
}
