import java.util.*;

class Solution {

    public int minMirrorPairDistance(int[] nums) {

        int n = nums.length;
        int ans = n + 1;

        Map<Integer, Integer> map = new HashMap<>();

        for (int i = 0; i < n; i++) {

            // is the reverse of nums[i]
            if (map.containsKey(nums[i])) {
                ans = Math.min(ans, i - map.get(nums[i]));
            }

            // Store the reversed value with current index
            map.put(reverse(nums[i]), i);
        }

        return ans > n ? -1 : ans;
    }

    private int reverse(int num) {

        int rev = 0;

        while (num > 0) {
            rev = rev * 10 + num % 10;
            num /= 10;
        }

        return rev;
    }
}
