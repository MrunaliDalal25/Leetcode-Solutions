
class Solution {
    public int minPatches(int[] nums, int n) {

        long missing = 1;
        int patches = 0;
        int i = 0;

        while (missing <= n) {

            if (i < nums.length && nums[i] <= missing) {

                // Existing number extends the range
                missing += nums[i];
                i++;

            } else {

                // Patch the missing number
                missing += missing;
                patches++;
            }
        }

        return patches;
    }
}
