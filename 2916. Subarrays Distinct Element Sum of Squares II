
class Solution {
    private static final long MOD = 1_000_000_007L;

    private long[] sum;
    private long[] sumSq;
    private long[] lazy;
    private int n;

    public int sumCounts(int[] nums) {
        n = nums.length;

        sum = new long[4 * n];
        sumSq = new long[4 * n];
        lazy = new long[4 * n];

        int[] last = new int[100001];
        java.util.Arrays.fill(last, -1);

        long answer = 0;

        for (int i = 0; i < n; i++) {
            int value = nums[i];
            int prev = last[value];

            update(1, 0, n - 1, prev + 1, i);

            answer = (answer + query(1, 0, n - 1, 0, i)) % MOD;

            last[value] = i;
        }

        return (int) answer;
    }

    private void apply(int node, int left, int right, long delta) {
        long len = right - left + 1L;

        sumSq[node] = (
            sumSq[node]
            + 2L * delta % MOD * sum[node] % MOD
            + delta * delta % MOD * len % MOD
        ) % MOD;

        sum[node] = (sum[node] + delta * len) % MOD;
        lazy[node] = (lazy[node] + delta) % MOD;
    }

    private void push(int node, int left, int right) {
        if (lazy[node] == 0 || left == right) {
            return;
        }

        int mid = left + (right - left) / 2;
        long delta = lazy[node];

        apply(node * 2, left, mid, delta);
        apply(node * 2 + 1, mid + 1, right, delta);

        lazy[node] = 0;
    }

    private void pull(int node) {
        sum[node] = (sum[node * 2] + sum[node * 2 + 1]) % MOD;
        sumSq[node] = (sumSq[node * 2] + sumSq[node * 2 + 1]) % MOD;
    }

    private void update(
        int node, int left, int right,
        int ql, int qr
    ) {
        if (ql > right || qr < left) {
            return;
        }

        if (ql <= left && right <= qr) {
            apply(node, left, right, 1);
            return;
        }

        push(node, left, right);

        int mid = left + (right - left) / 2;

        update(node * 2, left, mid, ql, qr);
        update(node * 2 + 1, mid + 1, right, ql, qr);

        pull(node);
    }

    private long query(
        int node, int left, int right,
        int ql, int qr
    ) {
        if (ql > right || qr < left) {
            return 0;
        }

        if (ql <= left && right <= qr) {
            return sumSq[node];
        }

        push(node, left, right);

        int mid = left + (right - left) / 2;

        long a = query(node * 2, left, mid, ql, qr);
        long b = query(node * 2 + 1, mid + 1, right, ql, qr);

        return (a + b) % MOD;
    }
}
