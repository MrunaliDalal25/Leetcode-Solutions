import java.util.*;

class Solution {
    public int[][] minAbsDiff(int[][] grid, int k) {
        int m = grid.length;
        int n = grid[0].length;

        int[][] ans = new int[m - k + 1][n - k + 1];

        for (int r = 0; r <= m - k; r++) {
            for (int c = 0; c <= n - k; c++) {

                TreeSet<Integer> set = new TreeSet<>();

                for (int i = r; i < r + k; i++) {
                    for (int j = c; j < c + k; j++) {
                        set.add(grid[i][j]);
                    }
                }

                if (set.size() <= 1) {
                    ans[r][c] = 0;
                    continue;
                }

                int minDiff = Integer.MAX_VALUE;
                Integer prev = null;

                for (int val : set) {
                    if (prev != null) {
                        minDiff = Math.min(minDiff, val - prev);
                    }
                    prev = val;
                }

                ans[r][c] = minDiff;
            }
        }

        return ans;
    }
}
