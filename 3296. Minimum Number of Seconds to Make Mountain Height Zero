class Solution {

    public long minNumberOfSeconds(int mountainHeight, int[] workerTimes) {

        long left = 0;
        long right = 1L * workerTimes[0] * mountainHeight * (mountainHeight + 1) / 2;

        for (int w : workerTimes) {
            right = Math.max(
                right,
                1L * w * mountainHeight * (mountainHeight + 1) / 2
            );
        }

        long ans = right;

        while (left <= right) {
            long mid = left + (right - left) / 2;

            if (can(mid, mountainHeight, workerTimes)) {
                ans = mid;
                right = mid - 1;
            } else {
                left = mid + 1;
            }
        }

        return ans;
    }

    private boolean can(long time, int mountainHeight, int[] workerTimes) {

        long removed = 0;

        for (int w : workerTimes) {

            long x = (long) (
                (Math.sqrt(1.0 + 8.0 * time / w) - 1) / 2
            );

            while ((long) w * x * (x + 1) / 2 > time) {
                x--;
            }

            removed += x;

            if (removed >= mountainHeight) {
                return true;
            }
        }

        return false;
    }
}
